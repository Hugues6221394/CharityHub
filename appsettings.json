{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=trigga;Initial Catalog=STUDENT_HUB_DB;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  }, 
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PayPal": {
    "ClientId": "YOUR_PAYPAL_CLIENT_ID",
    "ClientSecret": "YOUR_PAYPAL_CLIENT_SECRET",
    "Mode": "sandbox",
    "ReturnUrl": "https://localhost:5001/donation/paypal-success",
    "CancelUrl": "https://localhost:5001/donation/paypal-cancel"
  },
  "MTNMobileMoney": {
    "ApiKey": "YOUR_MTN_API_KEY",
    "ApiSecret": "YOUR_MTN_API_SECRET",
    "Environment": "sandbox"
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_API_KEY",
    "FromEmail": "noreply@studentcharityhub.com",
    "FromName": "Student Charity Hub"
  },
  "GoogleOAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  }
}

