                                        {
                                            <form asp-action="MarkAsRead" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@n.Id" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm btn-mark-read">
                                                    Mark as Read
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <p class="display-4 opacity-25"></p>
                                <h4>You’re all caught up!</h4>
                                <p class="text-muted">No new notifications right now.<br>Check back later — good things are happening.</p>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>

</body>
