<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Student Charity Hub</title>

    <!-- Bootstrap 5.3 + Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --coral: #ff5a5f;
            --teal: #0d9488;
            --cream: #fffaf0;
            --dark: #1f2937;
            --gray: #94a3b8;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            color: var(--dark);
            font-size: 0.95rem;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        a {
            text-decoration: none !important;
        }

        /* Navbar – Clean Coral to Teal Gradient */
        .navbar {
            background: linear-gradient(135deg, var(--coral), var(--teal));
            box-shadow: 0 8px 25px rgba(255,90,95,0.25);
            padding: 0.9rem 0;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.35rem;
            color: white !important;
        }

        .nav-link {
            color: rgba(255,255,255,0.95) !important;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .nav-link:hover, .nav-link.active {
                background: rgba(255,255,255,0.18);
                color: white !important;
            }

        .dropdown-menu {
            border: none;
            border-radius: 16px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.12);
            padding: 0.75rem;
        }

        .dropdown-item {
            border-radius: 10px;
            font-weight: 500;
        }

            .dropdown-item:hover {
                background: #fff8f5;
                color: var(--coral);
            }

        /* Notification Badge */
        .badge-notification {
            font-size: 0.65rem;
            padding: 0.25em 0.5em;
            border-radius: 50px;
            top: -8px;
            right: -8px;
        }

        /* Main Content */
        main {
            flex: 1;
            padding-top: 2.5rem;
            padding-bottom: 4rem;
        }

        /* Footer – Soft & Minimal */
        footer {
            background: white;
            padding: 1.8rem 0;
            margin-top: auto;
            box-shadow: 0 -8px 30px rgba(0,0,0,0.06);
            font-size: 0.9rem;
            color: var(--gray);
        }

            footer a {
                color: var(--teal);
                font-weight: 500;
            }

                footer a:hover {
                    color: var(--coral);
                }

        /* Alert Styling – Softer */
        .alert {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            font-weight: 500;
        }
    </style>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Navbar -->
    <header>
