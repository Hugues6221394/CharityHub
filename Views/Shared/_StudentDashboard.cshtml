<body>

    <!-- Hero -->
    <section class="page-hero">
        <div class="container hero-content">
            <h1 class="hero-title">Welcome back, @(user?.FirstName ?? "Student")!</h1>
            <p class="hero-subtitle">
                You’re not alone — kind hearts are making your dreams possible, one step at a time.
            </p>
        </div>
    </section>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="floating-card">

                    <!-- Stats Grid -->
                    <div class="p-4 p-md-5">
                        <div class="row g-4">
                            <div class="col-md-6 col-lg-3">
                                <div class="stat-card">
                                    <div class="stat-header">
                                        <div class="stat-value">Active</div>
                                        <div class="stat-label">My Profile</div>
                                        <i class="bi bi-person-heart stat-icon"></i>
                                    </div>
                                    <div class="stat-body">
                                        <a asp-controller="Student" asp-action="MyProfile" class="btn btn-action">View Profile</a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-3">
                                <div class="stat-card">
                                    <div class="stat-header">
                                        <div class="stat-value">Support</div>
                                        <div class="stat-label">My Donors</div>
                                        <i class="bi bi-people-fill stat-icon"></i>
                                    </div>
                                    <div class="stat-body">
                                        <a asp-controller="Student" asp-action="MyDonors" class="btn btn-action">See Donors</a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-3">
                                <div class="stat-card">
                                    <div class="stat-header">
                                        <div class="stat-value">@recentMessagesList.Count</div>
                                        <div class="stat-label">Messages</div>
                                        <i class="bi bi-envelope-heart-fill stat-icon"></i>
                                    </div>
                                    <div class="stat-body">
                                        <a asp-controller="Messages" asp-action="Index" class="btn btn-action">Open Inbox</a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-3">
                                <div class="stat-card">
                                    <div class="stat-header">
                                        <div class="stat-value">Help</div>
                                        <div class="stat-label">Need Support?</div>
                                        <i class="bi bi-headset stat-icon"></i>
                                    </div>
                                    <div class="stat-body">
                                        <a asp-controller="Messages" asp-action="ContactAdmin" class="btn btn-action">Contact Admin</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions + Recent Messages -->
                    <div class="row g-4 p-4 p-md-5 pt-0">
                        <div class="col-lg-6">
                            <div class="panel-card">
                                <div class="panel-header">Quick Actions</div>
                                <div class="p-4">
                                    <a asp-controller="Student" asp-action="MyProfile" class="quick-btn">
                                        View My Public Profile
                                    </a>
                                    <a asp-controller="Student" asp-action="MyDonors" class="quick-btn">
                                        See Who’s Supporting Me
                                    </a>
                                    <a asp-controller="Messages" asp-action="Index" class="quick-btn">
                                        Read Messages from Donors
                                    </a>
                                    <a asp-controller="Messages" asp-action="ContactAdmin" class="quick-btn">
                                        Contact Platform Admin
                                    </a>
                                    <a asp-controller="Account" asp-action="Manage" class="quick-btn">
                                        Account Settings
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="panel-card">
                                <div class="panel-header d-flex justify-content-between align-items-center">
