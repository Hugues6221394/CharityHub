@using StudentCharityHub.Models
@using System.Security.Claims
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@inject StudentCharityHub.Repositories.IUnitOfWork UnitOfWork
@{
    ViewData["Title"] = "Student Dashboard";
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var user = await UserManager.FindByIdAsync(userId!);
    var recentMessages = await UnitOfWork.Messages.FindAsync(m => m.ReceiverId == userId);
    var recentMessagesList = recentMessages.OrderByDescending(m => m.CreatedAt).Take(5).ToList();
}

<!DOCTYPE html>
<html lang="en">
