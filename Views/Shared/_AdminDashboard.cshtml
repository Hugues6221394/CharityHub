@using StudentCharityHub.Models
@{
    var totalStudents = ViewBag.TotalStudents as int? ?? 0;
    var totalDonations = ViewBag.TotalDonations as int? ?? 0;
    var totalAmount = ViewBag.TotalAmount as decimal? ?? 0;
    var totalUsers = ViewBag.TotalUsers as int? ?? 0;
    var recentDonations = ViewBag.RecentDonations as List<Donation> ?? new();
    var recentStudents = ViewBag.RecentStudents as List<Student> ?? new();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin • Student Charity Hub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --coral: #ff5a5f;
            --teal: #0d9488;
            --cream: #fffaf0;
            --dark: #1f2937;
            --gray: #94a3b8;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            color: var(--dark);
        }

        a {
            text-decoration: none !important;
        }

        /* Hero – Quiet & Powerful */
        .hero {
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1950&q=80') center/cover;
            min-height: 380px;
            display: flex;
            align-items: center;
            border-radius: 0 0 40px 40px;
            position: relative;
            overflow: hidden;
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(255,90,95,0.9), rgba(13,148,136,0.85));
            }

            .hero h1 {
                font-size: 3.4rem;
                font-weight: 700;
                margin: 0;
            }

            .hero p {
                font-size: 1.4rem;
                opacity: 0.95;
                margin-top: 0.8rem;
            }

        /* Floating Content */
        .content {
            margin-top: -100px;
            position: relative;
            z-index: 10;
        }

        /* Big Impact Numbers */
        .impact {
            background: white;
            border-radius: 32px;
            padding: 2.5rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            text-align: center;
            transition: transform 0.4s ease;
        }

            .impact:hover {
                transform: translateY(-12px);
            }

        .impact-num {
            font-size: 3.8rem;
            font-weight: 800;
            background: linear-gradient(135deg, var(--coral), var(--teal));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .impact-label {
            font-size: 1.1rem;
            color: var(--gray);
            margin-top: 0.5rem;
            font-weight: 600;
        }

        /* Quick Cards */
        .card-minimal {
            background: white;
            border-radius: 28px;
            padding: 2rem;
            box-shadow: 0 12px 40px rgba(0,0,0,0.08);
            height: 100%;
            transition: all 0.35s ease;
        }

            .card-minimal:hover {
                transform: translateY(-8px);
                box-shadow: 0 25px 60px rgba(255,90,95,0.18);
            }

        .card-title {
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 1.2rem;
        }

        .activity-item {
            padding: 1rem 0;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .activity-item:last-child {
                border: none;
            }

        .btn-action {
            background: linear-gradient(135deg, var(--coral), var(--teal));
            color: white;
            padding: 1rem 2rem;
            border-radius: 20px;
            font-weight: 600;
            box-shadow: 0 12px 30px rgba(255,90,95,0.3);
            transition: all 0.4s ease;
        }

            .btn-action:hover {
                transform: translateY(-6px);
                box-shadow: 0 20px 40px rgba(255,90,95,0.4);
            }

        @media (max-width: 768px) {
            .hero h1

        {
            font-size: 2.6rem;
        }

        .hero p {
            font-size: 1.2rem;
        }

        .content {
            margin: 1rem;
            margin-top: -70px;
        }

        }
    </style>
</head>
<body>

    <!-- Hero -->
    <section class="hero text-white text-center">
        <div class="container">
            <h1>Admin Dashboard</h1>
            <p>Every number here is a life being changed. Thank you.</p>
        </div>
    </section>

    <div class="container content">
        <div class="row g-5">

            <!-- Impact Overview -->
            <div class="col-12 mb-5">
                <div class="row g-4 text-center">
                    <div class="col-sm-6 col-lg-3">
                        <div class="impact">
                            <div class="impact-num">@totalStudents</div>
                            <div class="impact-label">Students Helped</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="impact">
                            <div class="impact-num">@totalDonations</div>
                            <div class="impact-label">Total Donations</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="impact">
                            <div class="impact-num">$@totalAmount:N0</div>
                            <div class="impact-label">Funds Raised</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <div class="impact">
                            <div class="impact-num">@totalUsers</div>
                            <div class="impact-label">Community Members</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="col-lg-7">
                <div class="card-minimal">
                    <h3 class="card-title">Recent Activity</h3>
                    @if (recentDonations.Any() || recentStudents.Any())
                    {
                        @foreach (var d in recentDonations.Take(4))
                        {
                            <div class="activity-item">
                                <div>
                                    <strong class="text-success">$@d.Amount:N0</strong> donated
                                    <small class="text-muted d-block">@d.CreatedAt:MMM dd, yyyy</small>
                                </div>
                                <span class="badge bg-success rounded-pill">Completed</span>
                            </div>
                        }
                        @foreach (var s in recentStudents.Take(3))
                        {
                            <div class="activity-item">
                                <div>
                                    New student: <strong>@s.FullName</strong>
                                    <small class="text-muted d-block">@s.Location</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">No activity yet — it all starts here</p>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="col-lg-5">
                <div class="card-minimal d-flex flex-column h-100 justify-content-between">
                    <div>
                        <h3 class="card-title">Quick Actions</h3>
                        <div class="d-grid gap-3">
                            <a asp-action="Students" class="btn btn-outline-primary rounded-pill py-3">Manage Students</a>
                            <a asp-action="Donations" class="btn btn-outline-primary rounded-pill py-3">View Donations</a>
                            <a asp-action="Users" class="btn btn-outline-primary rounded-pill py-3">Manage Users</a>
                            <a asp-controller="Student" asp-action="Create" class="btn btn-outline-primary rounded-pill py-3">Add New Student</a>
                            <a asp-controller="Messages" asp-action="Moderate" class="btn btn-outline-primary rounded-pill py-3">Moderate Messages</a>
                        </div>
                    </div>
                    <div class="mt-4">
                        <a asp-controller="Reports" asp-action="Index" class="btn btn-action w-100">
                            View Full Reports
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
