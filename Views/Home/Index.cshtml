            color: var(--gray);
            font-size: 0.95rem;
            margin-bottom: 1rem;
        }

        .progress-container {
            background: #f1f5f9;
            height: 12px;
            border-radius: 50px;
            overflow: hidden;
            margin: 1rem 0;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--coral), var(--teal));
            border-radius: 50px;
            width: 0;
            transition: width 1.2s ease;
        }

        .funding-text {
            font-size: 1.1rem;
