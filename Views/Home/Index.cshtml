<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Student Charity Hub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --coral: #ff5a5f;
            --coral-light: #ff7a7d;
            --teal: #0d9488;
            --cream: #fffaf0;
            --dark: #1f2937;
            --gray: #94a3b8;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            color: var(--dark);
            line-height: 1.7;
        }

        /* HERO - EMOTIONAL & POWERFUL */
        .hero {
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&q=80') center/cover no-repeat;
            min-height: 90vh;
            display: flex;
            align-items: center;
            color: white;
            text-align: center;
            position: relative;
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(255,90,95,0.7) 0%, rgba(13,148,136,0.6) 100%);
            }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem;
        }

        .logo-hero {
            width: 90px;
            height: 90px;
            margin: 0 auto 1.5rem;
            background: white;
            color: var(--coral);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        }

        .hero h1 {
            font-size: 3.8rem;
            font-weight: 800;
            letter-spacing: -1px;
            text-shadow: 0 4px 15px rgba(0,0,0,0.4);
        }

        .hero p {
            font-size: 1.4rem;
            font-weight: 500;
            opacity: 0.95;
            max-width: 700px;
            margin: 1.5rem auto;
        }

        .btn-hero {
            background: white;
            color: var(--coral);
            font-weight: 700;
            padding: 1rem 3rem;
            border-radius: 50px;
            font-size: 1.3rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
        }

            .btn-hero:hover {
                transform: translateY(-5px);
                background: var(--coral);
                color: white;
                box-shadow: 0 20px 40px rgba(255,90,95,0.4);
            }

        /* SECTION TITLE */
        .section-title {
            font-size: 2.6rem;
            font-weight: 800;
            text-align: center;
            position: relative;
            margin-bottom: 4rem;
            color: var(--dark);
        }

            .section-title::after {
                content: '';
                position: absolute;
                bottom: -15px;
                left: 50%;
                transform: translateX(-50%);
                width: 80px;
                height: 5px;
                background: linear-gradient(90deg, var(--coral), var(--teal));
                border-radius: 3px;
            }

        /* STUDENT CARDS */
        .student-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.4s ease;
            height: 100%;
        }

            .student-card:hover {
                transform: translateY(-15px);
                box-shadow: 0 25px 50px rgba(255,90,95,0.2);
            }

        .student-img {
            height: 220px;
            object-fit: cover;
