        }

            .btn-donate:hover {
                background: var(--teal);
                transform: translateY(-3px);
            }

        /* EMPTY STATE */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            color: var(--gray);
        }

            .empty-state i {
                font-size: 5rem;
                opacity: 0.5;
            }

            font-size: 2.8rem;
        }

        .hero p {
            font-size: 1.2rem;
        }

        .section-title {
            font-size: 2.2rem;
        }

        }
    </style>
</head>
<body>

    <div class="hero">
        <div class="container hero-content">
            <div class="logo-hero">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h1>Change a Student's Future Today</h1>
            <p>Every donation directly funds education for talented students who just need a helping hand. 100% transparent. 100% impact.</p>
            <a asp-controller="Student" asp-action="Index" class="btn-hero">Support a Student Now</a>
        </div>
    </div>

    <section class="container py-5">
        <h2 class="section-title">Students Waiting For Your Help</h2>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-heart-fill"></i>
                <p class="mt-4 fs-4">No active campaigns right now.<br>Check back soon — new stories of hope are added daily.</p>
            </div>
        }
        else
        {
            <div class="row g-5">
                @foreach (var student in Model)
                {
                    var progress = student.FundingGoal > 0 ? Math.Min(100, (student.AmountRaised / student.FundingGoal) * 100) : 0;

                    <div class="col-md-6 col-lg-4">
                        <div class="student-card">
                            @if (!string.IsNullOrEmpty(student.PhotoUrl))
                            {
                                <img src="@student.PhotoUrl" class="student-img w-100" alt="@student.FullName">
                            }
                            else
                            {
                                <div class="student-img bg-light d-flex align-items-center justify-content-center">
                                    <i class="bi bi-person-fill text-muted" style="font-size: 6rem; opacity: 0.3;"></i>
                                </div>
                            }

                            <div class="card-body">
                                <h3 class="student-name">@student.FullName</h3>
                                <p class="student-location">
                                    <i class="bi bi-geo-alt-fill"></i> @student.Location
                                </p>

                                <div class="progress-container">
                                    <div class="progress-fill" style="width: @progress%"></div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="funding-text">
                                        <strong class="amount-raised">$@student.AmountRaised.ToString("N0")</strong> raised
                                    </span>
                                    <small class="text-muted">of $@student.FundingGoal.ToString("N0")</small>
                                </div>

                                <div class="d-flex gap-2">
                                    <a asp-controller="Student" asp-action="Details" asp-route-id="@student.Id"
                                       class="btn btn-outline-secondary flex-fill">Read Story</a>
                                    <a asp-controller="Donation" asp-action="Create" asp-route-studentId="@student.Id"
                                       class="btn btn-donate flex-fill">Donate Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</body>
</html>
