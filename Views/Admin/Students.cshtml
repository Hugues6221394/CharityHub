@model IEnumerable<StudentCharityHub.Models.Student>
@{
    ViewData["Title"] = "Manage Students";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Student Charity Hub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --coral: #ff5a5f;
            --teal: #0d9488;
            --cream: #fffaf0;
            --dark: #1f2937;
            --gray: #94a3b8;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            color: var(--dark);
            font-size: 0.95rem;
        }

        a {
            text-decoration: none !important;
        }

        /* Hero */
        .page-hero {
            background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.75)), url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1950&q=80') center/cover;
            min-height: 260px;
            display: flex;
            align-items: center;
            border-radius: 0 0 32px 32px;
            position: relative;
            overflow: hidden;
        }

            .page-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(255,90,95,0.88), rgba(13,148,136,0.78));
            }

        .hero-content {
            position: relative;
            text-align: center;
            color: white;
        }

        .hero-title {
            font-size: 2.4rem;
            font-weight: 700;
            margin-bottom: 0.4rem;
        }

        .hero-subtitle {
            font-size: 1.1rem;
            opacity: 0.95;
        }

        /* Table Card */
        .table-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
            margin-top: -80px;
            position: relative;
            z-index: 10;
        }

        .table-header {
            background: linear-gradient(135deg, var(--coral), var(--teal));
            color: white;
            padding: 1.6rem 2rem;
            font-weight: 600;
            font-size: 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-add {
            background: white;
            color: var(--teal);
            font-weight: 600;
            border-radius: 16px;
            padding: 0.75rem 1.6rem;
            transition: all 0.3s ease;
        }

            .btn-add:hover {
                background: var(--coral);
                color: white;
                transform: translateY(-3px);
            }

        th {
            font-weight: 600;
            color: var(--dark);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        td {
            vertical-align: middle;
            font-size: 0.95rem;
        }

        tr:hover {
            background-color: #fff8f5 !important;
        }

        .badge {
            font-size: 0.8rem;
            padding: 0.45em 0.9em;
            border-radius: 50px;
        }

        .badge-visible {
            background: var(--teal);
        }

        .badge-hidden {
            background: #e2e8f0;
            color: #64748b;
        }

        .btn-action {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: all 0.25s ease;
        }

        .btn-view {
            background: #ecfeff;
            color: #0891b2;
        }

        .btn-edit {
            background: #fffbeb;
            color: #d97706;
        }

        .btn-msg {
            background: #f0fdf4;
            color: #16a34a;
        }

        .btn-delete {
            background: #fef2f2;
            color: #dc2626;
        }

        .btn-action:hover {
            transform: translateY(-4px) scale(1.1);
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

     

        {
            font-size: 2rem;
        }

        .table-card {
            margin: 1rem;
            margin-top: -60px;
        }

        }
    </style>
</head>
<body>

    <!-- Hero -->
    <section class="page-hero">
        <div class="container hero-content">
            <h1 class="hero-title">Manage Students</h1>
            <p class="hero-subtitle">Review and manage all student profiles</p>
        </div>
    </section>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-11">
                <div class="table-card">
                    <div class="table-header">
                        <span>All Students (@Model.Count())</span>
                        <a asp-controller="Student" asp-action="Create" class="btn btn-add">
                            Add New Student
                        </a>
                    </div>

                    <div class="p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="text-secondary small">
                                    <tr>
                                        <th>Name</th>
                                        <th>Age</th>
                                        <th>Location</th>
                                        <th>Goal</th>
                                        <th>Raised</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model)
                                    {
                                        <tr>
                                            <td class="fw-medium">@s.FullName</td>
                                            <td>@s.Age</td>
                                            <td>@s.Location</td>
                                            <td class="fw-bold text-danger">$@s.FundingGoal.ToString("N0")</td>
                                            <td class="fw-bold text-success">$@s.AmountRaised.ToString("N0")</td>
                                            <td>
                                                @if (s.IsVisible)
                                                {
                                                    <span class="badge badge-visible">Visible</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-hidden">Hidden</span>
                                                }
                                            </td>
                                            <td>@s.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="text-end">
                                                <a asp-controller="Student" asp-action="Details" asp-route-id="@s.Id"
                                                   class="btn btn-action btn-view me-2" title="View">
                                                </a>
                                                <a asp-controller="Student" asp-action="Edit" asp-route-id="@s.Id"
                                                   class="btn btn-action btn-edit me-2" title="Edit">
                                                </a>
                                                <a asp-controller="Messages" asp-action="ContactStudent" asp-route-studentId="@s.Id"
                                                   class="btn btn-action btn-msg me-2" title="Message">
                                                </a>
                                                <form asp-controller="Student" asp-action="Delete" asp-route-id="@s.Id"
                                                      method="post" class="d-inline"
                                                      onsubmit="return confirm('Permanently delete @s.FullName?');">
                                                    <button type="submit" class="btn btn-action btn-delete" title="Delete">
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            @if (!Model.Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <p class="mt-3 fs-4">No students added yet</p>
                                    <a asp-controller="Student" asp-action="Create" class="btn btn-add mt-3">
                                        Add Your First Student
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
