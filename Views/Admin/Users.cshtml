@model IEnumerable<dynamic>
@using StudentCharityHub.Models
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 fw-bold text-gradient">Users</h1>
        <a asp-action="AddUser" class="btn btn-success shadow-sm">
            <i class="bi bi-person-plus"></i> Add User
        </a>
    </div>

    <!-- Users Table Card -->
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Roles</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            ApplicationUser user = item.User;
                            var roles = item.Roles as IEnumerable<string> ?? Enumerable.Empty<string>();
                            <tr>
                                <td>@user.FirstName @user.LastName</td>
                                <td>@user.Email</td>
                                <td>@user.PhoneNumber</td>
                                <td>
                                    @foreach (var role in roles)
                                    {
                                        <span class="badge bg-info text-dark me-1">@role</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-action="EditUser" asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-primary me-1 shadow-sm" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post"
                                          class="d-inline" onsubmit="return confirm('Deactivate this user?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm" title="Deactivate">
                                            <i class="bi bi-person-dash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

