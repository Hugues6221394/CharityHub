@model StudentCharityHub.ViewModels.SendMessageViewModel
@{
    ViewData["Title"] = "Message Student";
    var student = ViewBag.Student as StudentCharityHub.Models.Student;
}

<div class="container">
    <h1 class="mb-4">Message Student</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (student != null)
            {
                <p class="text-muted">
                    Student: <strong>@student.FullName</strong> (@student.Location)
                </p>
            }

            <form asp-action="Create" method="post">
                <input type="hidden" asp-for="StudentId" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label"></label>
                    <textarea asp-for="Content" class="form-control" rows="5"
                              placeholder="Write your message to this student..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Donor" asp-action="MySponsoredStudents" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Send Message</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


