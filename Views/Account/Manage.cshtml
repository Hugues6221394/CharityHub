@model ManageViewModel
@{
    ViewData["Title"] = "Manage Profile";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-gradient">Manage Profile</h2>
        <p class="text-muted">Update your personal information and account settings</p>
    </div>

    <div class="row g-4">

        <!-- Profile Form -->
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">

                    <form asp-action="Manage" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <!-- First Name -->
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-semibold">First Name</label>
                                <input asp-for="FirstName" class="form-control form-control-lg rounded-3" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-semibold">Last Name</label>
                                <input asp-for="LastName" class="form-control form-control-lg rounded-3" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Email (readonly) -->
                        <div class="mb-3 mt-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control form-control-lg rounded-3" readonly />
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg rounded-3" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- Submit -->
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 shadow-sm">
                            Update Profile
                        </button>

                    </form>
                </div>
            </div>
        </div>

        <!-- Side Actions -->
        <div class="col-lg-4">

            <!-- Two-Factor Authentication Card -->
            <div class="card shadow-lg border-0 rounded-4 mb-4">
                <div class="card-header bg-gradient-primary text-white fw-bold">
                    Two-Factor Authentication
                </div>
                <div class="card-body text-center">
                    @if (Model.TwoFactorEnabled)
                    {
                        <p class="text-success fw-semibold">2FA is enabled</p>
                        <form asp-action="Disable2fa" method="post">
                            <button type="submit" class="btn btn-danger w-100 rounded-3 shadow-sm">
                                Disable 2FA
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="text-warning fw-semibold">2FA is disabled</p>
                        <a asp-action="EnableAuthenticator" class="btn btn-primary w-100 rounded-3 shadow-sm">
                            Enable 2FA
                        </a>
                    }
                </div>
            </div>

            <!-- Account Actions Card -->
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient-danger text-white fw-bold">
                    Account Actions
                </div>
                <div class="card-body text-center">
                    <form asp-action="DeleteAccount" method="post"
                          onsubmit="return confirm('Are you sure you want to deactivate your account?');">
                        <button type="submit" class="btn btn-danger w-100 rounded-3 shadow-sm">
                            Deactivate Account
                        </button>
                    </form>
                </div>
            </div>

        </div>

    </div>

</div>

<style>
    .text-gradient {
        background: linear-gradient(135deg, #667eea, #764ba2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea, #764ba2) !important;
    }

    .bg-gradient-danger {
        background: linear-gradient(135deg, #f56c6c, #d64545) !important;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
