        <a asp-controller="Student" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-search"></i> Find Students
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Amount</th>
