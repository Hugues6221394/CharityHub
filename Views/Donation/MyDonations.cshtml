@model IEnumerable<StudentCharityHub.Models.Donation>
@{
    ViewData["Title"] = "My Donations";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h1 class="h3 mb-0">My Donations</h1>
        <a asp-controller="Student" asp-action="Index" class="btn btn-primary shadow-sm">
            <i class="bi bi-search"></i> Find Students
        </a>
    </div>

    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Student</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var donation in Model)
                            {
                                <tr>
                                    <td>@donation.Student?.FullName</td>
                                    <td>$@donation.Amount.ToString("F2")</td>
                                    <td>@donation.PaymentMethod</td>
                                    <td>
                                        <span class="badge @(donation.Status switch
                                              {
                                                  "Completed" => "bg-success",
                                                  "Pending" => "bg-warning text-dark",
                                                  "Failed" => "bg-danger",
                                                  "Cancelled" => "bg-secondary",
                                                  _ => "bg-light text-dark"
                                              })">
                                    @donation.Status
                                </span>
                            </td>
                            <td>@donation.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(donation.ReceiptUrl))
                                        {
                                            <a href="@donation.ReceiptUrl" target="_blank"
                                               class="btn btn-sm btn-outline-primary shadow-sm">
                                                <i class="bi bi-receipt"></i> View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5 mb-0">You haven't made any donations yet.</p>
                    <a asp-controller="Student" asp-action="Index" class="btn btn-outline-primary mt-3 shadow-sm">
                        <i class="bi bi-plus-circle"></i> Start Donating
                    </a>
                </div>
            }
        </div>
    </div>
</div>

