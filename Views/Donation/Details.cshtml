@model StudentCharityHub.Models.Donation
@{
    ViewData["Title"] = "Donation Details";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4 border-0">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Donation Details</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-semibold">Student</dt>
                <dd class="col-sm-9">@Model.Student?.FullName (@Model.StudentId)</dd>

                <dt class="col-sm-3 fw-semibold">Amount</dt>
                <dd class="col-sm-9">$@Model.Amount.ToString("F2")</dd>

                <dt class="col-sm-3 fw-semibold">Payment Method</dt>
                <dd class="col-sm-9">@Model.PaymentMethod</dd>

                <dt class="col-sm-3 fw-semibold">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Status == "Completed" ? "bg-success" : Model.Status == "Pending" ? "bg-warning text-dark" : "bg-secondary")">
                        @Model.Status
                    </span>
                </dd>

                <dt class="col-sm-3 fw-semibold">Transaction ID</dt>
                <dd class="col-sm-9">@Model.TransactionId</dd>

                <dt class="col-sm-3 fw-semibold">Date</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>

                <dt class="col-sm-3 fw-semibold">Receipt</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.ReceiptUrl))
                    {
                        <a href="@Model.ReceiptUrl" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm">View Receipt</a>
                    }
                    else
                    {
                        <span class="text-muted">Not generated</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-4 d-flex flex-wrap gap-2">
        <a asp-controller="Student" asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-arrow-left-circle"></i> Back to Student
        </a>
        <a asp-action="MyDonations" class="btn btn-primary shadow-sm">
            <i class="bi bi-wallet2"></i> My Donations
        </a>
    </div>
</div>

<style>
